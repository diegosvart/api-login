{
"name": "api-login",
"version": "1.0.0",
"description": "**API de Autenticación Empresarial** implementada con **Algoritmos y Estructuras de Datos** (AEDD) optimizadas para alta performance y escalabilidad. Desarrollado con Node.js, TypeScript, Express y PostgreSQL, aplicando principios de Clean Architecture y patrones de diseño eficientes.",
"main": "dist/app.js",
"directories": {
"doc": "docs",
"test": "tests"
},
"scripts": {
"dev": "nodemon --exec ts-node src/app.ts",
"build": "tsc",
"start": "node dist/app.js",
"test": "echo \"Tests will be added later\"",
"test:watch": "echo \"Test watch will be added later\"",
"test:coverage": "echo \"Test coverage will be added later\"",
"lint": "eslint src/**/*.ts",
"lint:fix": "eslint src/**/*.ts --fix",
"format": "prettier --write src/**/*.ts",
"clean": "rimraf dist",
"db:setup": "ts-node scripts/setup-database.ts",
"db:migrate": "ts-node scripts/migrate.ts",
"db:seed": "ts-node scripts/seed.ts"
},
"keywords": [],
"author": "",
"license": "ISC",
"type": "commonjs",
"dependencies": {
"@types/uuid": "^10.0.0",
"bcryptjs": "^3.0.2",
"cors": "^2.8.5",
"dotenv": "^17.2.1",
"express": "^5.1.0",
"helmet": "^8.1.0",
"joi": "^18.0.0",
"jsonwebtoken": "^9.0.2",
"pg": "^8.16.3",
"uuid": "^11.1.0"
},
"devDependencies": {
"@types/bcryptjs": "^2.4.6",
"@types/cors": "^2.8.19",
"@types/express": "^5.0.3",
"@types/jest": "^30.0.0",
"@types/jsonwebtoken": "^9.0.10",
"@types/node": "^24.2.0",
"@types/pg": "^8.15.5",
"@types/supertest": "^6.0.3",
"jest": "^30.0.5",
"nodemon": "^3.1.10",
"supertest": "^7.1.4",
"ts-node": "^10.9.2",
"typescript": "^5.9.2"
}
}